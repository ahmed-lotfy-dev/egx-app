{
  "buildCommand": "bun run vercel-build",
  "installCommand": "bun install",
  "framework": null,
  "outputDirectory": "apps/api/public/admin",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}