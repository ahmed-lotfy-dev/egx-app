{
  "openapi": "3.1.0",
  "info": {
    "title": "EGX API",
    "version": "0.1.0",
    "description": "Market data, instruments, news, positions, alerts, and AI for the EGX app."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "API and database health",
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "up",
                        "down"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "version",
                    "time",
                    "database"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
