{
  "openapi": "3.1.0",
  "info": {
    "title": "EGX API",
    "version": "0.1.0",
    "description": "Market data, instruments, news, positions, alerts, and AI for the EGX app."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "API and database health",
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "up",
                        "down"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "version",
                    "time",
                    "database"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/status/data": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Last ingest run per job and stored row counts",
        "responses": {
          "200": {
            "description": "Data pipeline status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "jobs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "job": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "running",
                                  "success",
                                  "partial",
                                  "failed"
                                ]
                              },
                              "provider": {
                                "type": "string",
                                "nullable": true
                              },
                              "startedAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "finishedAt": {
                                "type": "string",
                                "nullable": true,
                                "format": "date-time"
                              },
                              "itemsOk": {
                                "type": "integer"
                              },
                              "itemsFailed": {
                                "type": "integer"
                              },
                              "error": {
                                "type": "string",
                                "nullable": true
                              },
                              "stale": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "job",
                              "status",
                              "provider",
                              "startedAt",
                              "finishedAt",
                              "itemsOk",
                              "itemsFailed",
                              "error",
                              "stale"
                            ]
                          }
                        },
                        "counts": {
                          "type": "object",
                          "properties": {
                            "instruments": {
                              "type": "integer"
                            },
                            "stocks": {
                              "type": "integer"
                            },
                            "indices": {
                              "type": "integer"
                            },
                            "quotes": {
                              "type": "integer"
                            },
                            "dailyBars": {
                              "type": "integer"
                            },
                            "barInstruments": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "instruments",
                            "stocks",
                            "indices",
                            "quotes",
                            "dailyBars",
                            "barInstruments"
                          ]
                        }
                      },
                      "required": [
                        "jobs",
                        "counts"
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "asOf": {
                          "type": "string",
                          "nullable": true,
                          "format": "date-time"
                        },
                        "source": {
                          "type": "string"
                        },
                        "stale": {
                          "type": "boolean"
                        },
                        "universeAsOf": {
                          "type": "string",
                          "nullable": true,
                          "format": "date-time"
                        },
                        "nextCursor": {
                          "type": "string",
                          "nullable": true
                        }
                      },
                      "required": [
                        "asOf",
                        "source",
                        "stale"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          }
        }
      }
    },
