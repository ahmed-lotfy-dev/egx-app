{
  "name": "@egx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "openapi:generate": "bun --env-file=../../.env src/scripts/generate-openapi.ts",
    "openapi:check": "bun --env-file=../../.env src/scripts/check-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.13",
    "@egx/contracts": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3"
  }
}
