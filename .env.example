# API (copy to .env at the repository root)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://egx:egx@127.0.0.1:5433/egx

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=egx://,http://localhost:8081,exp://127.0.0.1:8081

# Google sign in (optional in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP (optional in development; the code is logged when unset)
RESEND_API_KEY=
EMAIL_FROM=EGX <no-reply@example.com>

# Mobile (copy to apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
