# API (copy to .env at the repository root)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://egx:egx@127.0.0.1:5433/egx

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=ahmedlotfy-egx-app://,http://localhost:8081,exp://127.0.0.1:8081,exp://10.0.2.2:8081

# Google sign in (optional in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP (optional in development; the code is logged when unset)
RESEND_API_KEY=
EMAIL_FROM=EGX <no-reply@example.com>

# NVIDIA NIM (for AI news summarization & analysis)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Mobile (copy to apps/mobile/.env)
# The app always targets the deployed backend (https://egx-api.alotfy.site).
# There is no localhost/emulator override.
# Set to false only to hide the Google button deliberately.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=true
